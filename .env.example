# Required for live NEIS data. Never expose this as NEXT_PUBLIC_*.
# Leaving this empty while mock mode is false reports an unconfigured state.
NEIS_API_KEY=

# Mock data is used only when this is explicitly true.
NEIS_MOCK_MODE=false

# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
