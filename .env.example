# Optional in development: when omitted, deterministic mock data is used.
# Required for live production NEIS data. Never expose this as NEXT_PUBLIC_*.
NEIS_API_KEY=

# Set to true to force mock data even when an API key exists.
NEIS_MOCK_MODE=false

# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
